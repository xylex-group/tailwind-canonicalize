{
  "name": "tailwind-canonicalize-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r --filter \"@tailwind-canonicalize/*\" --filter tailwind-canonicalize run build && pnpm --filter tailwind-canonicalize-vscode run build",
    "dev": "pnpm -r --filter \"@tailwind-canonicalize/*\" --filter tailwind-canonicalize run dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc -b --pretty false",
    "lint": "ultracite check",
    "format": "ultracite fix && prettier --write \"**/*.astro\" --ignore-path .gitignore",
    "format:astro": "prettier --write \"**/*.astro\" --ignore-path .gitignore",
    "check": "ultracite check && prettier --check \"**/*.astro\" --ignore-path .gitignore",
    "fix": "ultracite fix && prettier --write \"**/*.astro\" --ignore-path .gitignore",
    "knip": "knip",
    "publint": "pnpm -r --filter \"@tailwind-canonicalize/*\" --filter tailwind-canonicalize exec publint",
    "benchmark": "tsx benchmarks/run.ts",
    "docs:dev": "pnpm --filter docs run dev",
    "docs:build": "pnpm --filter docs run build",
    "docs:deploy": "pnpm --filter docs run deploy",
    "docs:deploy:worker": "pnpm --filter docs run deploy:worker",
    "docs:deploy:dry-run": "pnpm --filter docs run deploy:dry-run",
    "docs:cf-typegen": "pnpm --filter docs run cf-typegen",
    "deploy": "pnpm run docs:deploy",
    "deploy:docs": "pnpm run docs:deploy",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build && changeset publish",
    "prepare": "husky || true"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.4",
    "@changesets/cli": "^2.29.6",
    "@types/node": "^22.17.2",
    "@vitest/coverage-v8": "^3.2.4",
    "husky": "^9.1.7",
    "knip": "^5.63.0",
    "lint-staged": "^16.1.5",
    "prettier": "^3.6.2",
    "prettier-plugin-astro": "^0.14.1",
    "publint": "^0.3.12",
    "tsx": "^4.20.4",
    "typescript": "^5.9.2",
    "ultracite": "^5.3.9",
    "vitest": "^3.2.4"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,jsonc,css,md,mdx}": [
      "pnpm exec ultracite fix"
    ],
    "*.astro": [
      "prettier --write"
    ]
  },
  "version": "0.2.0"
}