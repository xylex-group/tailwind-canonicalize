---
import Icon from "./icon.astro";
import Logo from "./logo.astro";

const footerNav = [
  {
    title: "Getting started",
    links: [
      { href: "/docs", label: "Introduction" },
      { href: "/docs/installation", label: "Installation" },
      { href: "/docs/cli", label: "CLI" },
      { href: "/docs/examples", label: "Examples" },
      { href: "/docs/api", label: "API" },
    ],
  },
  {
    title: "Features",
    links: [
      { href: "/docs/features/canonical", label: "Canonical classes" },
      { href: "/docs/features/migrations", label: "Migrations" },
      { href: "/docs/features/tokens", label: "Semantic tokens" },
      { href: "/docs/features/performance", label: "Performance" },
      { href: "/docs/safety", label: "Safety" },
    ],
  },
  {
    title: "Integrations",
    links: [
      { href: "/docs/integrations/biome", label: "Biome" },
      { href: "/docs/integrations/eslint", label: "ESLint" },
      { href: "/docs/integrations/oxlint", label: "Oxlint" },
      { href: "/docs/integrations/prettier", label: "Prettier" },
      { href: "/docs/integrations/ci", label: "CI & hooks" },
    ],
  },
  {
    title: "More",
    links: [
      { href: "/docs/architecture", label: "Architecture" },
      { href: "/docs/faq", label: "FAQ" },
      { href: "/docs/troubleshooting", label: "Troubleshooting" },
      { href: "/changelog", label: "Changelog" },
      {
        href: "https://github.com/xylex-group/tailwind-canonicalize",
        label: "GitHub",
      },
    ],
  },
];
---

<footer class="mb-24 flex flex-col gap-6">
  <div class="flex items-center justify-between gap-4">
    <div class="flex items-center gap-3">
      <Logo class="size-5" />
      <span class="font-semibold text-lg tracking-tight"
        >tailwind-canonicalize</span
      >
    </div>
    <div class="flex items-center gap-4">
      <a
        aria-label="View on GitHub"
        class="text-muted-foreground transition-colors hover:text-accent"
        href="https://github.com/xylex-group/tailwind-canonicalize"
        rel="noreferrer"
        target="_blank"
      >
        <Icon class="size-4" name="github" />
      </a>
    </div>
  </div>

  <div class="grid grid-cols-2 gap-8 sm:grid-cols-4">
    {
      footerNav.map((section) => (
        <div class="flex flex-col gap-3">
          <p class="font-medium text-sm">{section.title}</p>
          <ul class="flex flex-col gap-2">
            {section.links.map((link) => (
              <li>
                <a
                  class="text-muted-foreground text-sm transition-colors hover:text-accent"
                  href={link.href}
                  rel={
                    link.href.startsWith("http") ? "noreferrer" : undefined
                  }
                  target={link.href.startsWith("http") ? "_blank" : undefined}
                >
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
</footer>
