---
// Terminal mock of a successful canonicalize run
---

<div
  class="relative isolate overflow-hidden rounded-xl sm:rounded-2xl md:rounded-3xl"
>
  <img
    alt=""
    class="absolute top-0 left-0 size-full object-cover"
    height="738"
    src="/demo-background.jpg"
    width="1600"
  />
  <div class="size-full sm:px-16 sm:pt-16">
    <div
      class="max-h-128 overflow-hidden rounded-t-xl border border-border bg-background/90 p-8 backdrop-blur-sm sm:rounded-t-2xl"
    >
      <div
        class="pointer-events-none mb-8 grid select-none grid-cols-3 items-center"
      >
        <div class="flex items-center gap-2">
          <div class="size-2 rounded-full bg-border"></div>
          <div class="size-2 rounded-full bg-border"></div>
          <div class="size-2 rounded-full bg-border"></div>
        </div>
        <div class="flex items-center justify-center">
          <p class="font-mono text-muted-foreground text-xs">Terminal</p>
        </div>
      </div>
      <pre
        class="overflow-x-auto font-mono text-foreground text-xs sm:text-sm"><code><div class="mb-4"><span class="text-muted-foreground">$</span> pnpm exec tailwind-canonicalize src --write --safe --verbose</div><div><span class="text-cyan-600 dark:text-cyan-400">●</span> <span class="text-muted-foreground">Loaded theme from <span class="text-cyan-600 dark:text-cyan-400">src/app.css</span> (@theme)</span></div><div><span class="text-muted-foreground">│</span></div><div><span class="text-muted-foreground">  components/Card.tsx:12</span></div><div><span class="text-amber-600 dark:text-amber-400">  −</span> <span class="text-muted-foreground">w-[40px] p-[16px] max-w-[160px]</span></div><div><span class="text-green-600 dark:text-green-400">  +</span> <span class="text-muted-foreground">w-10 p-4 max-w-40</span></div><div><span class="text-muted-foreground">    category: canonical-class · safety: exact</span></div><div><span class="text-muted-foreground">│</span></div><div><span class="text-muted-foreground">  components/Hero.tsx:8</span></div><div><span class="text-amber-600 dark:text-amber-400">  −</span> <span class="text-muted-foreground">hover:bg-gradient-to-br</span></div><div><span class="text-green-600 dark:text-green-400">  +</span> <span class="text-muted-foreground">hover:bg-linear-to-br</span></div><div><span class="text-muted-foreground">    category: tailwind-migration</span></div><div><span class="text-muted-foreground">│</span></div><div><span class="text-green-600 dark:text-green-400">✓</span> 1,523 files</div><div><span class="text-green-600 dark:text-green-400">✓</span> 9,421 replacements</div><div><span class="text-green-600 dark:text-green-400">✓</span> 0 unsafe rewrites</div><div><span class="text-muted-foreground">Completed in 1.82s</span></div></code></pre>
    </div>
  </div>
</div>
