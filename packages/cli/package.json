{
  "name": "tailwind-canonicalize",
  "version": "0.1.1",
  "description": "Semantic canonicalizer for Tailwind CSS utility classes — rewrite only when provably identical",
  "license": "MIT",
  "type": "module",
  "bin": {
    "tailwind-canonicalize": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "schema"
  ],
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "tailwind",
    "tailwindcss",
    "canonicalize",
    "formatter",
    "css",
    "utilities",
    "cli"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xylex-group/tailwind-canonicalize.git"
  },
  "bugs": {
    "url": "https://github.com/xylex-group/tailwind-canonicalize/issues"
  },
  "homepage": "https://github.com/xylex-group/tailwind-canonicalize#readme",
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "magic-string": "^0.30.17",
    "oxc-parser": "^0.82.1"
  },
  "peerDependencies": {
    "tailwindcss": ">=3.4.0 || >=4.0.0"
  },
  "peerDependenciesMeta": {
    "tailwindcss": {
      "optional": true
    }
  },
  "devDependencies": {
    "@tailwind-canonicalize/compiler": "workspace:*",
    "@tailwind-canonicalize/resolver": "workspace:*",
    "@tailwind-canonicalize/tokens": "workspace:*",
    "tsup": "^8.5.0",
    "typescript": "^5.9.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
